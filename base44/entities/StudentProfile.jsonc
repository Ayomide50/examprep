{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to User"
    },
    "email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "department_id": {
      "type": "string",
      "description": "Department assigned to this student"
    },
    "department_name": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "description": "Current academic level e.g. 100"
    },
    "level_history": {
      "type": "array",
      "description": "Log of academic level changes, kept permanently",
      "items": {
        "type": "object",
        "properties": {
          "previous_level": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "changed_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "level_stats": {
      "type": "object",
      "description": "Per-level progress counters keyed by academic level, e.g. {\"100\": {\"answered\": 120, \"correct\": 90, \"mock_exams\": 3, \"practice_sessions\": 5}}"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Consecutive days of learning activity up to the last activity date"
    },
    "longest_streak": {
      "type": "number",
      "default": 0,
      "description": "Best consecutive-day streak ever achieved"
    },
    "last_activity_date": {
      "type": "string",
      "description": "Local date (YYYY-MM-DD) of the last counted learning activity"
    },
    "streak_history": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dates (YYYY-MM-DD) on which the student was active, most recent last"
    },
    "streak_milestones": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Streak milestones already reached, e.g. [3, 7, 14]"
    },
    "referral_code": {
      "type": "string",
      "description": "Optional referral code entered at registration"
    },
    "my_referral_code": {
      "type": "string",
      "description": "This student's own unique referral code to share"
    },
    "profile_image": {
      "type": "string",
      "description": "URL of uploaded profile image"
    },
    "is_activated": {
      "type": "boolean",
      "default": false,
      "description": "Whether the student's CURRENT academic level is activated"
    },
    "activation_code": {
      "type": "string"
    },
    "activation_date": {
      "type": "string",
      "format": "date-time"
    },
    "access_expires": {
      "type": "string",
      "format": "date-time",
      "description": "Null means full_time access"
    },
    "free_trial_used": {
      "type": "object",
      "description": "Map of course_id to number of free questions answered"
    },
    "total_questions_answered": {
      "type": "number",
      "default": 0
    },
    "total_correct": {
      "type": "number",
      "default": 0
    },
    "total_practice_sessions": {
      "type": "number",
      "default": 0
    },
    "total_mock_exams": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ]
}