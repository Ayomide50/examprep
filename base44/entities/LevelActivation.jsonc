{
  "name": "LevelActivation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the student's User record"
    },
    "student_profile_id": {
      "type": "string",
      "description": "Reference to the student's StudentProfile"
    },
    "level": {
      "type": "string",
      "description": "Academic level this activation covers e.g. 200"
    },
    "department_id": {
      "type": "string"
    },
    "department_name": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this level activation is currently valid"
    },
    "activation_code": {
      "type": "string"
    },
    "activation_date": {
      "type": "string",
      "format": "date-time"
    },
    "access_duration": {
      "type": "string",
      "description": "Duration of the code used e.g. full_time, 30_days"
    },
    "access_expires": {
      "type": "string",
      "format": "date-time",
      "description": "Null means full_time access"
    }
  },
  "required": [
    "user_id",
    "level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}